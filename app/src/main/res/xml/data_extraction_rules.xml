<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Cloud backup is limited to 25 MB and skips the whole app when it's over, so everything downloaded again
     when needed (the card list, models, price and set caches), the app's own backups and photos stay out.
     A phone-to-phone transfer has no such limit, so it keeps the photos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models" />
        <exclude domain="file" path="art-index" />
        <exclude domain="file" path="photos" />
        <exclude domain="file" path="backups" />
        <exclude domain="file" path="ck-buylist.tsv" />
        <exclude domain="file" path="card-names.txt" />
        <exclude domain="file" path="scan-log.jsonl" />
        <exclude domain="file" path="before-restore.json" />
        <exclude domain="file" path="house-sync" />
        <exclude domain="file" path="auto-backups" />
        <exclude domain="file" path="card-lists" />
        <exclude domain="file" path="prints" />
        <exclude domain="file" path="precons" />
        <exclude domain="file" path="scan-photos" />
        <exclude domain="file" path="test-photos" />
        <exclude domain="file" path="combos.tsv.gz" />
        <exclude domain="file" path="salt.tsv" />
        <exclude domain="database" path="local-cards.db" />
        <exclude domain="database" path="local-cards.db-wal" />
        <exclude domain="database" path="local-cards.db-shm" />
        <exclude domain="database" path="local-cards.db.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models" />
        <exclude domain="file" path="art-index" />
        <exclude domain="file" path="ck-buylist.tsv" />
        <exclude domain="file" path="card-names.txt" />
        <exclude domain="file" path="before-restore.json" />
        <exclude domain="file" path="house-sync" />
        <exclude domain="database" path="local-cards.db" />
        <exclude domain="database" path="local-cards.db-wal" />
        <exclude domain="database" path="local-cards.db-shm" />
        <exclude domain="database" path="local-cards.db.tmp" />
        <exclude domain="file" path="card-lists" />
        <exclude domain="file" path="prints" />
    </device-transfer>
</data-extraction-rules>
